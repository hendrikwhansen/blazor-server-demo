@* One component, two URLs: create and edit. The C# lives in CustomerEdit.razor.cs ("code-behind"). *@
@page "/customers/new"
@page "/customers/{Id:int}/edit"

<PageTitle>@(IsNew ? "New customer" : "Edit customer")</PageTitle>

<h1>@(IsNew ? "New customer" : "Edit customer")</h1>

@if (customer is null)
{
    <p><em>Loading...</em></p>
}
else
{
    @* EditForm + DataAnnotationsValidator replace RequiredFieldValidator, RegularExpressionValidator etc.
       The rules come from the attributes on the Customer class. OnValidSubmit only runs if all rules pass. *@
    <EditForm Model="customer" OnValidSubmit="SaveAsync" class="col-lg-6">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        <div class="mb-3">
            <label for="name" class="form-label">Name</label>
            <InputText id="name" class="form-control" @bind-Value="customer.Name" />
            <ValidationMessage For="() => customer.Name" class="text-danger" />
        </div>

        <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <InputText id="email" type="email" class="form-control" @bind-Value="customer.Email" />
            <ValidationMessage For="() => customer.Email" class="text-danger" />
        </div>

        <div class="mb-3">
            <label for="phone" class="form-label">Phone</label>
            <InputText id="phone" type="tel" class="form-control" @bind-Value="customer.Phone" />
            <ValidationMessage For="() => customer.Phone" class="text-danger" />
        </div>

        <div class="mb-3">
            <label for="city" class="form-label">City</label>
            <InputText id="city" class="form-control" @bind-Value="customer.City" />
            <ValidationMessage For="() => customer.City" class="text-danger" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@saving">Save</button>
        <a class="btn btn-link" href="@(IsNew ? "customers" : $"customers/{Id}")">Cancel</a>
    </EditForm>
}
