@page "/customers"
@implements IAsyncDisposable
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Customers</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Customers</h1>
    <a class="btn btn-primary" href="customers/new">New customer</a>
</div>

@* @bind:event="oninput" refreshes the grid on every keystroke - no postback, no page reload. *@
<input class="form-control mb-3" placeholder="Search by name or city..."
       @bind="searchText" @bind:event="oninput" @bind:after="GoToFirstPage" />

@* QuickGrid is the modern GridView. With the EF Core adapter, sorting and paging
   are executed in SQL (ORDER BY ... OFFSET/FETCH), so only one page of rows is loaded. *@
<QuickGrid Class="table table-striped table-hover" Items="FilteredCustomers" Pagination="pagination">
    <PropertyColumn Property="c => c.Name" Sortable="true" IsDefaultSortColumn="true" />
    <PropertyColumn Property="c => c.City" Sortable="true" />
    <PropertyColumn Property="c => c.Email" />
    <PropertyColumn Property="c => c.Phone" />
    <TemplateColumn Context="customer">
        <a href="@($"customers/{customer.Id}")">Details</a> |
        <a href="@($"customers/{customer.Id}/edit")">Edit</a>
    </TemplateColumn>
</QuickGrid>

<Paginator State="pagination" />

@code {
    private AppDbContext db = default!;
    private PaginationState pagination = new() { ItemsPerPage = 10 };
    private string searchText = "";

    // The grid needs a DbContext that lives as long as the page, so it is created here
    // and disposed in DisposeAsync below.
    protected override void OnInitialized() => db = DbFactory.CreateDbContext();

    // An IQueryable is a not-yet-executed query. QuickGrid adds sorting/paging to it,
    // and EF Core turns the whole thing into a single SQL statement with a WHERE ... LIKE.
    private IQueryable<Customer> FilteredCustomers =>
        string.IsNullOrWhiteSpace(searchText)
            ? db.Customers
            : db.Customers.Where(c => c.Name.Contains(searchText) || (c.City != null && c.City.Contains(searchText)));

    private Task GoToFirstPage() => pagination.SetCurrentPageIndexAsync(0);

    public async ValueTask DisposeAsync() => await db.DisposeAsync();
}
